# zenreset.sh configuration
#
# Copy to ~/.config/zenreset/config.env and edit. The file is sourced by the
# script, so use shell syntax. Every value below mirrors the built-in default;
# leave a line commented out to keep that default.

# --- proxy ports -------------------------------------------------------------
# Local SOCKS5 port spoken by the WARP engine.
SOCKS_PORT=18086
# Local HTTP port. privoxy bridges SOCKS -> HTTP here, and OpenCode talks to it.
HTTP_PORT=18118

# --- rotation ----------------------------------------------------------------
# Attempts per engine before moving to the next engine.
MAX_ATTEMPTS=6
# Seconds to sleep between attempts.
ATTEMPT_SLEEP=3
# Engine order. usque is first because it is the only engine that survives
# proot's missing CAP_NET_ADMIN.
ENGINES="usque warp-plus-linux warp-plus-android cloudflare-warp"
# Force a single engine (empty = use ENGINES order).
ENGINE=""
# warp-plus exit mode: warp | psiphon | scan.
EXIT_MODE=warp
# Country passed to psiphon mode (EXIT_MODE=psiphon).
PSIPHON_COUNTRY=US
# Extra args appended to warp-plus invocations. -4 keeps it on IPv4.
WARP_EXTRA_ARGS=-4
# 1 adds --tun-experimental to warp-plus (0 = off).
WARP_TUN=0

# --- verification ------------------------------------------------------------
# 1 = probe Zen through the proxy after the IP changes, 0 = skip the probe.
PROBE_ZEN=1
# Model used for the tiny probe request.
PROBE_MODEL=deepseek-v4.1-flash-free
# 1 = delete the local OpenCode cache after a successful reset.
CLEAR_CACHE=1
# Seconds between polls in `watch` mode.
WATCH_INTERVAL=60
# 1 = require the egress IP to differ from the previous one before proceeding.
FORCE_NEW_IP=1
# Seconds to wait for an engine to boot.
ENGINE_BOOT_WAIT=6
# Seconds to wait for real egress through the proxy.
PROXY_WAIT=30

# --- opencode serve ----------------------------------------------------------
# 1 = start `opencode serve` automatically after a successful reset/start.
SERVE_AUTOSTART=1
# 1 = daemonise serve by default (overridden by --bg / --fg).
SERVE_BACKGROUND=0
# Bind address for `opencode serve`.
SERVE_HOST=127.0.0.1
# Port for `opencode serve`.
SERVE_PORT=4096
# Extra arguments appended to `opencode serve`.
SERVE_ARGS=""
# Seconds to wait for serve to come up in background mode.
SERVE_WAIT=3
# 1 = restart an already-running serve after a reset.
SERVE_RESTART_ON_RESET=1
